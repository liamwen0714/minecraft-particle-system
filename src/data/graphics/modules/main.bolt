import math
import random

spawn_height = 10

function effects:load:
    scoreboard objectives add timer dummy

function effects:circle1:
    for i in range(100):
        theta = 2 * math.pi * i / 100
        
        radius = 5
        x = radius * math.sin(theta)
        y = 10
        z = radius * math.cos(theta)
        
        particle flame ~x ~y ~z

function effects:circle2:
    for i in range(100):
        theta = 2 * math.pi * i / 100
        
        radius = 5
        x = radius * math.sin(theta)
        y = 10
        z = radius * math.cos(theta)
        
        particle totem_of_undying ~x ~y ~z

function effects:sphere1:
    for i in range(100):
        theta = math.pi * i / 100
        
        for j in range(100):
            phi = 2 * math.pi * j / 100

            radius = 3
            x = radius * math.sin(theta) * math.cos(phi)
            y = (radius * math.sin(theta) * math.sin(phi)) + spawn_height
            z = radius * math.cos(theta)

            particle cherry_leaves ~x ~y ~z

function effects:sphere2:
    for i in range(100):
        theta = math.pi * i / 100
        
        for j in range(100):
            phi = 2 * math.pi * j / 100
            r = 0.1 * i
            g = 0.1 * i
            b = 0.1 * i

            radius = 3
            x = radius * math.sin(theta) * math.cos(phi)
            y = (radius * math.sin(theta) * math.sin(phi)) + spawn_height
            z = radius * math.cos(theta)

            particle instant_effect{color:[r, g, b]} ~x ~y ~z

function effects:sphere3:
    for i in range(100):
        theta = math.pi * i / 100
        
        for j in range(100):
            phi = 2 * math.pi * j / 100
            r = random.randrange(1, 257) / 256
            g = random.randrange(1, 257) / 256
            b = random.randrange(1, 257) / 256

            radius = 3
            x = radius * math.sin(theta) * math.cos(phi)
            y = (radius * math.sin(theta) * math.sin(phi)) + spawn_height
            z = radius * math.cos(theta)

            particle instant_effect{color:[r, g, b]} ~x ~y ~z

function effects:sphere4:
    scoreboard players add @s timer 1  
    for frame in range(1, 11):
        execute if score @s timer matches frame:
            for i in range(100):
                theta = math.pi * i / 100
                for j in range(100):
                    phi = 2 * math.pi * j / 100
                    r = frame / 10
                    g = frame / 10
                    b = frame / 10

                    radius = 3
                    x = radius * math.sin(theta) * math.cos(phi)
                    y = (radius * math.sin(theta) * math.sin(phi)) + spawn_height
                    z = radius * math.cos(theta)

                    particle instant_effect{color:[r, g, b]} ~x ~y ~z

    execute if score @s timer matches 10 run scoreboard players set @s timer 0

